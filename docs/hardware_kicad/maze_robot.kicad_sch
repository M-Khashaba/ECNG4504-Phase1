	(text "Notes:"
		(exclude_from_sim no)
		(at 39.37 199.39 0)
		(effects
			(font
				(size 2.2 2.2)
			)
			(justify left bottom)
		)
		(uuid "0ab5cb33-824a-4111-9020-fee740889230")
	)
	(text "- The 12 V supply powers the L298N motor driver; the L298N 5 V regulator powers the ESP32 (VIN)."
		(exclude_from_sim no)
		(at 39.37 205.74 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "3072c4d8-0d61-461d-9cf0-4a21395d2329")
	)
	(text "- Sensor outputs: black line = LOW. GPIO 34-39 are input-only pins, used only for the sensors."
		(exclude_from_sim no)
		(at 39.37 220.98 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "3e62d80f-17aa-43c4-b30d-ff4a95a027b0")
	)
	(text "- Each side has two motors in parallel (4-wheel skid steering). Onboard LED on GPIO 2 mirrors the status LED."
		(exclude_from_sim no)
		(at 39.37 226.06 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "65432178-5352-4c63-b64a-6f1818f6f31d")
	)
	(text "- All grounds are joined (supply, L298N, ESP32, sensor). The 1000 uF capacitor smooths motor current spikes."
		(exclude_from_sim no)
		(at 39.37 210.82 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "72885e7b-6440-43de-a366-b483d7b59472")
	)
	(text "- ENA/ENB jumpers removed: speed is PWM from GPIO 25 / 26. GPIO 13 is not used (damaged on our board)."
		(exclude_from_sim no)
		(at 39.37 215.9 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "c1412973-4116-4635-b501-c6215f237dd5")
	)
